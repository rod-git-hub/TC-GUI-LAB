#!/usr/bin/env bash
# TC Lab CLI wrapper — installed to /usr/local/bin/tc-lab by setup.sh.
# Runs cli.py with the application's own virtualenv so bcrypt is available,
# and points it at the same state directory the service uses.
set -euo pipefail

INSTALL_DIR="${TC_LAB_DIR:-/opt/tc_lab}"
PY="${INSTALL_DIR}/venv/bin/python"

[ -x "$PY" ] || PY="$(command -v python3)"
[ -f "${INSTALL_DIR}/cli.py" ] || {
  echo "error: TC Lab not found at ${INSTALL_DIR}" >&2
  echo "       set TC_LAB_DIR=/path/to/tc_lab if it is installed elsewhere" >&2
  exit 1
}

# Use the state directory the installed service uses, unless the caller
# overrode it: the unit's TC_LAB_STATE_DIR (/var/lib/tc_lab from v9.3 on), or
# the install directory for a unit that has none (before v9.3).
if [ -z "${TC_LAB_STATE_DIR:-}" ]; then
  UNIT="${TC_LAB_UNIT_DIR:-/etc/systemd/system}/${TC_LAB_SERVICE:-tc_lab}.service"
  TC_LAB_STATE_DIR=$(sed -n 's/^Environment=TC_LAB_STATE_DIR=//p' "$UNIT" 2>/dev/null | head -1)
  TC_LAB_STATE_DIR="${TC_LAB_STATE_DIR:-$INSTALL_DIR}"
fi
export TC_LAB_STATE_DIR

cd "$INSTALL_DIR"
exec "$PY" "${INSTALL_DIR}/cli.py" "$@"
