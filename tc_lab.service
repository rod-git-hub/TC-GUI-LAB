[Unit]
Description=TC Lab WAN Emulator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# An unprivileged system user, created by setup.sh. The service is handed the
# two network capabilities it needs (below) instead of running as root.
User=tc-lab
Group=tc-lab
# Code: /opt/tc_lab, owned by root and read-only to the service.
# State (accounts, settings, certificate, saved impairments, topology, profiles):
# /var/lib/tc_lab, owned by tc-lab — the only place the service can write.
WorkingDirectory=/opt/tc_lab
Environment=TC_LAB_STATE_DIR=/var/lib/tc_lab
ExecStartPre=/bin/bash /opt/tc_lab/restore_network.sh
ExecStart=/opt/tc_lab/venv/bin/python /opt/tc_lab/app.py
Restart=on-failure
RestartSec=5

# ── Capabilities ────────────────────────────────────────────────────────────
# Ambient capabilities give a non-root process these two — and nothing else —
# and pass them on to the ip/tc commands it runs. The bounding set makes sure
# nothing can ever add more.
#
#   CAP_NET_ADMIN   ip link / tc qdisc / bridge, VLANs
#   CAP_NET_RAW     carried over from v9.2; whether netem needs it is being
#                   verified — remove it here if every operation passes without
#
# CAP_SYS_MODULE is deliberately NOT granted: it means loading arbitrary code
# into the kernel. It is not needed — when `ip link add ... type vlan` or
# `tc qdisc add ... htb` asks for a module that is not loaded, the KERNEL loads
# it (rtnl-link-* / sch_* aliases), independently of the caller's capabilities.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes

# ── Filesystem ──────────────────────────────────────────────────────────────
# The whole filesystem is read-only to the service except its state directory.
# Keep ReadWritePaths equal to TC_LAB_STATE_DIR above (setup.sh rewrites both).
ProtectSystem=strict
ReadWritePaths=/var/lib/tc_lab
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
UMask=0077

# ── Kernel, processes, system calls ─────────────────────────────────────────
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
# AF_NETLINK is how ip and tc talk to the kernel; AF_INET/INET6 serve the
# dashboard; AF_UNIX is used by the Python runtime.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
